# Copy this file to .env and fill in real values before running the server.

# --- Database ---
# SQLite (zero-config): stores everything as one file next to this project.
# Comfortably handles a few thousand shops and a few hundred partners. On a
# host with a persistent disk (a VPS, a Docker volume, Render/Railway with a
# disk attached) this just works; on a platform with an ephemeral filesystem
# you'll want to point this at a mounted volume, or move to Postgres later
# (see the comment at the top of src/db.js).
DB_FILE="./data.sqlite3"

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# --- Server ---
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the exact URL your frontend is served from in production.
CORS_ORIGIN="http://localhost:3000"

# --- Admin account (created automatically the first time the server starts) ---
ADMIN_PHONE=9175767207
ADMIN_PASSWORD=Pravin@12345
ADMIN_NAME="pick-any-password-you-want"

# --- Razorpay ---
# From your Razorpay Dashboard > Settings > API Keys.
# Test mode keys (rzp_test_...) work exactly like live keys for development.
RAZORPAY_KEY_ID=rzp_test_SiCF5ATfGe7q3I
RAZORPAY_KEY_SECRET=tXrLge5En3CGZCtl3yLM0StV
# From Razorpay Dashboard > Settings > Webhooks, when you add the webhook
# pointing at POST /api/payments/webhook (see the setup notes for events to enable).
RAZORPAY_WEBHOOK_SECRET="9666d6262cdd930e01a9dded777b420575cc5af022f9ab35508a2a31f5bbe846"
