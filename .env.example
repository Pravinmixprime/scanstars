# Copy this file to .env and fill in real values before running the server.

# --- Database ---
# A Postgres connection string. A free Supabase project (supabase.com, no
# credit card required) gives you one: create a project, then go to
# Project Settings > Database > Connection string ("URI" / "Transaction
# pooler" mode) and paste it here, filling in the database password you set
# when creating the project. This works identically for local development
# and for a deployed server (e.g. a free Render web service) — the database
# lives on Supabase either way, so nothing is lost when a free host's disk
# gets wiped on restart.
DATABASE_URL=postgresql://postgres:intelcore%40I3@db.fzlnmymojdlsmqzdxbbv.supabase.co:5432/postgres

# --- Auth ---
# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET="change-this-to-a-long-random-string"

# --- Server ---
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the exact URL your frontend is served from in production.
CORS_ORIGIN="http://localhost:3000"

# --- Admin account (created by `npm run seed`, part of `npm run setup`) ---
ADMIN_PHONE="admin"
ADMIN_PASSWORD="change-this-admin-password"
ADMIN_NAME="ScanStars HQ"

# --- Razorpay ---
# From your Razorpay Dashboard > Settings > API Keys.
# Test mode keys (rzp_test_...) work exactly like live keys for development.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# From Razorpay Dashboard > Settings > Webhooks, when you add the webhook
# pointing at POST /api/payments/webhook (see the setup notes for events to enable).
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
